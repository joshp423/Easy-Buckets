// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id Int @id @default(autoincrement())
  password String
  email String @unique
  team Teams? @relation("team")
}

model Players {
  id Int @id @default(autoincrement())
  name String
  number Int
  teamId Int
  team Teams @relation("players", fields: [teamId], references: [id])
  gameStatlines GameStatlines[] @relation("gameStatlines")
}

model Teams {
  id Int @id @default(autoincrement())
  name String
  players Players[] @relation("players")
  userId Int @unique
  users Users @relation("team", fields: [userId], references: [id])
  seasons Seasons[] @relation("seasons")
}

model Seasons {
  id Int @id @default(autoincrement())
  name String
  teamId Int
  dateCreated DateTime @default(now())
  team Teams @relation("seasons", fields: [teamId], references: [id])
  games Games[] @relation("games")
}

model Games {
  id Int @id @default(autoincrement())
  seasonId Int
  season Seasons @relation("games", fields: [seasonId], references: [id])
  gameStatlines GameStatlines[] @relation("gameStatlines")
  date DateTime 
  opponent String
  replay String?
}

model GameStatlines {
  id Int @id @default(autoincrement())
  gameId Int
  game Games @relation("gameStatlines", fields: [gameId], references: [id])
  playerId Int
  player Players @relation("gameStatlines", fields: [playerId], references: [id])
  twoPointFGMiss Int
  twoPointFGMake Int
  threePointFGMiss Int
  threePointFGMake Int
  fTMiss Int
  fTMake Int
  oReb Int
  dReb Int
  assist Int
  block Int
  steal Int
  turnover Int
  pF Int
  twoPointFGPercent Int
  threePointFGPercent Int
  fTPercent Int
  totalRebounds Int
  points Int
  shots Shots[] @relation("shots")
}

model Shots {
  id Int @id @default(autoincrement())
  gameStatlineId Int
  gameStatline GameStatlines @relation("shots",  fields: [gameStatlineId], references: [id])
  make Boolean
  X Int
  Y Int
  type Int
}